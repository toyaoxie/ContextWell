<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ContextWell Lab — Human-Centered AI, Digital Literacy & Institutional Resilience</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --white: #FAFAF8;
    --off-white: #F4F3F0;
    --light-gray: #E8E7E3;
    --mid-gray: #9B9A97;
    --charcoal: #2C2C2A;
    --near-black: #16160F;
    --navy: #0F1E3C;
    --muted-blue: #2D5B8E;
    --light-blue: #E8EFF7;
    --accent-blue: #3B6FA0;
    --serif: 'Instrument Serif', Georgia, serif;
    --sans: 'Geist', system-ui, sans-serif;
    --mono: 'Geist Mono', monospace;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; font-size: 16px; }

  body {
    background: var(--white);
    color: var(--charcoal);
    font-family: var(--sans);
    font-weight: 400;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  /* ─── NAV ─── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(250,250,248,0.92);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--light-gray);
    padding: 0 48px;
    height: 64px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .nav-logo {
    font-family: var(--sans); font-weight: 600; font-size: 14px;
    color: var(--near-black); letter-spacing: 0.02em; text-decoration: none;
  }
  .nav-logo span { color: var(--muted-blue); }
  .nav-links {
    display: flex; gap: 36px; list-style: none;
  }
  .nav-links a {
    font-size: 13px; color: var(--charcoal); text-decoration: none;
    letter-spacing: 0.02em; font-weight: 400;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--muted-blue); }
  .nav-cta {
    background: var(--navy); color: #fff;
    padding: 8px 20px; border-radius: 4px;
    font-size: 13px; font-weight: 500; text-decoration: none;
    letter-spacing: 0.02em; transition: background 0.2s;
  }
  .nav-cta:hover { background: var(--muted-blue); }

  /* ─── HERO ─── */
  .hero {
    min-height: 100vh;
    padding: 160px 48px 100px;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .hero-left {}
  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--light-blue); border: 1px solid #C8D8EA;
    color: var(--muted-blue); border-radius: 2px;
    padding: 6px 14px; font-size: 11px; font-weight: 500;
    letter-spacing: 0.08em; text-transform: uppercase;
    margin-bottom: 40px;
  }
  .hero-badge-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent-blue); }
  .hero-h1 {
    font-family: var(--serif);
    font-size: clamp(36px, 4.5vw, 58px);
    line-height: 1.12;
    color: var(--near-black);
    margin-bottom: 28px;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .hero-h1 em { font-style: italic; color: var(--muted-blue); }
  .hero-sub {
    font-size: 17px; line-height: 1.7; color: #5A5A58;
    max-width: 480px; margin-bottom: 48px; font-weight: 300;
  }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 56px; }
  .btn-primary {
    background: var(--navy); color: #fff;
    padding: 13px 26px; border-radius: 4px;
    font-family: var(--sans); font-size: 14px; font-weight: 500;
    text-decoration: none; letter-spacing: 0.02em;
    transition: background 0.2s, transform 0.15s;
    display: inline-block;
  }
  .btn-primary:hover { background: var(--muted-blue); transform: translateY(-1px); }
  .btn-secondary {
    background: transparent; color: var(--navy);
    padding: 13px 26px; border-radius: 4px;
    font-family: var(--sans); font-size: 14px; font-weight: 500;
    text-decoration: none; letter-spacing: 0.02em;
    border: 1.5px solid var(--navy);
    transition: all 0.2s;
    display: inline-block;
  }
  .btn-secondary:hover { background: var(--navy); color: #fff; transform: translateY(-1px); }
  .btn-ghost {
    background: transparent; color: var(--muted-blue);
    padding: 12px 24px; border-radius: 4px;
    font-family: var(--sans); font-size: 13px; font-weight: 500;
    text-decoration: none; letter-spacing: 0.02em;
    border: 1px solid #C8D8EA;
    transition: all 0.2s;
    display: inline-block;
  }
  .btn-ghost:hover { background: var(--light-blue); }

  .hero-affiliations {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    font-size: 12px; color: var(--mid-gray); letter-spacing: 0.06em;
  }
  .hero-affiliations .sep { color: var(--light-gray); }
  .aff-tag { font-weight: 500; color: #777674; }

  .hero-right {
    position: relative;
  }
  .hero-diagram {
    width: 100%; aspect-ratio: 1;
    position: relative;
    display: flex; align-items: center; justify-content: center;
  }
  .diagram-svg { width: 100%; max-width: 420px; }

  /* ─── SECTION COMMONS ─── */
  section { padding: 100px 48px; }
  .container { max-width: 1100px; margin: 0 auto; }
  .section-label {
    font-size: 11px; font-weight: 500; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--muted-blue);
    margin-bottom: 16px;
    display: flex; align-items: center; gap: 10px;
  }
  .section-label::before {
    content: ''; display: block; width: 24px; height: 1px;
    background: var(--accent-blue);
  }
  .section-title {
    font-family: var(--serif);
    font-size: clamp(28px, 3.5vw, 42px);
    color: var(--near-black); font-weight: 400;
    line-height: 1.2; letter-spacing: -0.01em;
    margin-bottom: 20px;
  }
  .section-desc {
    font-size: 17px; color: #5A5A58; line-height: 1.7;
    max-width: 600px; font-weight: 300;
  }

  /* ─── DIVIDER ─── */
  .divider { height: 1px; background: var(--light-gray); max-width: 1100px; margin: 0 auto; }

  /* ─── CHALLENGE SECTION ─── */
  .challenge { background: var(--off-white); }
  .challenge-header { margin-bottom: 64px; }
  .challenge-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px;
    background: var(--light-gray);
    border: 1px solid var(--light-gray);
  }
  .challenge-card {
    background: var(--white); padding: 36px 28px;
    transition: background 0.2s;
    cursor: default;
  }
  .challenge-card:hover { background: var(--light-blue); }
  .challenge-num {
    font-family: var(--mono); font-size: 11px; color: var(--mid-gray);
    letter-spacing: 0.06em; margin-bottom: 20px; display: block;
  }
  .challenge-icon {
    width: 32px; height: 32px; margin-bottom: 20px;
    color: var(--muted-blue);
  }
  .challenge-card h3 {
    font-family: var(--sans); font-size: 14px; font-weight: 600;
    color: var(--near-black); margin-bottom: 12px; letter-spacing: 0.01em;
    line-height: 1.3;
  }
  .challenge-card p {
    font-size: 13.5px; color: #6B6B68; line-height: 1.65;
  }

  /* ─── WHY SECTION ─── */
  .why { background: var(--navy); }
  .why .section-label { color: #7BA3CC; }
  .why .section-label::before { background: #5B87B3; }
  .why .section-title { color: var(--white); }
  .why-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 60px;
    margin-top: 64px;
  }
  .why-col {}
  .why-item {
    padding: 28px 0;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  .why-item:first-child { border-top: none; padding-top: 0; }
  .why-item h4 {
    font-size: 14px; font-weight: 600; color: #E8EFF7;
    margin-bottom: 10px; letter-spacing: 0.01em;
  }
  .why-item p { font-size: 14px; color: #8B9BAD; line-height: 1.7; }
  .why-stat {
    margin-top: 64px; padding-top: 48px;
    border-top: 1px solid rgba(255,255,255,0.1);
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px;
  }
  .why-stat-item {}
  .why-stat-num {
    font-family: var(--serif); font-size: 42px; color: #7BA3CC;
    font-weight: 400; line-height: 1; margin-bottom: 8px;
  }
  .why-stat-label { font-size: 13px; color: #6B7E93; line-height: 1.4; }

  /* ─── SERVICES ─── */
  .services {}
  .services-header {
    display: flex; justify-content: space-between; align-items: flex-end;
    margin-bottom: 64px;
  }
  .services-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2px;
    background: var(--light-gray);
    border: 1px solid var(--light-gray);
  }
  .service-card {
    background: var(--white); padding: 44px 40px;
    transition: background 0.2s;
    position: relative;
  }
  .service-card:hover { background: #FAFBFF; }
  .service-type {
    font-size: 11px; font-weight: 500; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--muted-blue);
    margin-bottom: 20px; display: block;
  }
  .service-card h3 {
    font-family: var(--serif); font-size: 24px; font-weight: 400;
    color: var(--near-black); margin-bottom: 16px; line-height: 1.2;
  }
  .service-card > p {
    font-size: 14.5px; color: #5A5A58; line-height: 1.7; margin-bottom: 24px;
  }
  .service-features {
    list-style: none; margin-bottom: 32px;
  }
  .service-features li {
    font-size: 13.5px; color: #777674; padding: 6px 0;
    border-bottom: 1px solid var(--light-gray);
    display: flex; align-items: flex-start; gap: 8px;
    line-height: 1.4;
  }
  .service-features li::before {
    content: '→'; color: var(--muted-blue); flex-shrink: 0;
    font-size: 12px; margin-top: 2px;
  }
  .service-audience {
    font-size: 12px; color: var(--mid-gray); margin-bottom: 28px;
    padding: 10px 14px; background: var(--off-white);
    border-radius: 2px;
  }
  .service-audience strong { color: #777674; font-weight: 500; }
  .service-cta {
    font-size: 13px; font-weight: 500; color: var(--muted-blue);
    text-decoration: none; letter-spacing: 0.02em;
    display: inline-flex; align-items: center; gap: 6px;
    transition: gap 0.2s;
  }
  .service-cta:hover { gap: 10px; }
  .service-card.featured { background: var(--navy); }
  .service-card.featured .service-type { color: #7BA3CC; }
  .service-card.featured h3 { color: var(--white); }
  .service-card.featured > p { color: #8B9BAD; }
  .service-card.featured .service-features li { color: #7B8A9A; border-color: rgba(255,255,255,0.08); }
  .service-card.featured .service-features li::before { color: #7BA3CC; }
  .service-card.featured .service-audience { background: rgba(255,255,255,0.06); color: #6B7E93; }
  .service-card.featured .service-audience strong { color: #8B9BAD; }
  .service-card.featured .service-cta { color: #7BA3CC; }

  /* ─── APPROACH ─── */
  .approach { background: var(--off-white); }
  .approach-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
    margin-top: 64px; border: 1px solid var(--light-gray);
    background: var(--light-gray);
  }
  .approach-pillar {
    background: var(--white); padding: 40px 28px;
    transition: background 0.2s;
  }
  .approach-pillar:hover { background: var(--light-blue); }
  .pillar-num {
    font-family: var(--mono); font-size: 28px; font-weight: 400;
    color: var(--light-gray); margin-bottom: 24px; line-height: 1;
    display: block;
  }
  .approach-pillar h3 {
    font-family: var(--sans); font-size: 14px; font-weight: 600;
    color: var(--near-black); margin-bottom: 12px;
    line-height: 1.3; letter-spacing: 0.01em;
  }
  .approach-pillar p { font-size: 13.5px; color: #6B6B68; line-height: 1.65; }

  /* ─── WHITEPAPER ─── */
  .whitepaper {}
  .wp-inner {
    display: grid; grid-template-columns: 1fr 1fr; gap: 80px;
    align-items: center;
  }
  .wp-mockup {
    position: relative;
  }
  .wp-cover {
    background: var(--navy);
    padding: 48px 40px; border-radius: 2px;
    position: relative; overflow: hidden;
    box-shadow: 20px 20px 60px rgba(15,30,60,0.15), 0 4px 20px rgba(0,0,0,0.1);
  }
  .wp-cover::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 40px,
      rgba(255,255,255,0.02) 40px,
      rgba(255,255,255,0.02) 41px
    );
  }
  .wp-cover-label {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.12em;
    text-transform: uppercase; color: #5B87B3; margin-bottom: 32px;
  }
  .wp-cover-title {
    font-family: var(--serif); font-size: 22px; font-weight: 400;
    color: var(--white); line-height: 1.25; margin-bottom: 24px;
  }
  .wp-cover-title em { font-style: italic; color: #7BA3CC; }
  .wp-cover-sub {
    font-size: 12px; color: #5B7A96; line-height: 1.6; margin-bottom: 36px;
  }
  .wp-cover-meta {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 20px;
    font-family: var(--mono); font-size: 10px; color: #4A6070;
    letter-spacing: 0.06em;
  }
  .wp-content {}
  .wp-content .section-label { margin-bottom: 16px; }
  .wp-content .section-title { margin-bottom: 20px; }
  .wp-abstract {
    font-size: 15px; color: #5A5A58; line-height: 1.75; margin-bottom: 32px;
    font-weight: 300;
  }
  .wp-themes {
    display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 36px;
  }
  .theme-tag {
    font-size: 12px; background: var(--light-blue);
    color: var(--muted-blue); padding: 5px 12px;
    border-radius: 2px; border: 1px solid #C8D8EA;
    letter-spacing: 0.03em;
  }

  /* ─── PROTOTYPE ─── */
  .prototype { background: var(--off-white); }
  .proto-header { margin-bottom: 48px; }
  .proto-notice {
    display: inline-flex; align-items: center; gap: 8px;
    background: #FFF8E7; border: 1px solid #E8D99A;
    color: #7A6830; border-radius: 2px;
    padding: 8px 16px; font-size: 12px; font-weight: 500;
    letter-spacing: 0.04em; margin-bottom: 40px;
  }
  .proto-grid {
    display: grid; grid-template-columns: 5fr 4fr; gap: 40px;
    align-items: start;
  }
  .proto-mockup-wrap {
    background: var(--white); border: 1px solid var(--light-gray);
    border-radius: 4px; overflow: hidden;
    box-shadow: 0 8px 32px rgba(0,0,0,0.06);
  }
  .proto-bar {
    background: #F0EFEB; padding: 10px 16px;
    display: flex; align-items: center; gap: 6px;
    border-bottom: 1px solid var(--light-gray);
  }
  .proto-dot { width: 10px; height: 10px; border-radius: 50%; }
  .proto-url {
    flex: 1; background: var(--white); border: 1px solid var(--light-gray);
    border-radius: 100px; padding: 3px 12px;
    font-family: var(--mono); font-size: 10px; color: var(--mid-gray);
    margin-left: 8px;
  }
  .proto-screen { padding: 28px; }
  .proto-screen-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 24px;
  }
  .proto-screen-title {
    font-size: 13px; font-weight: 600; color: var(--near-black);
  }
  .proto-badge-sm {
    font-size: 10px; background: #EAF0F7; color: var(--muted-blue);
    padding: 3px 8px; border-radius: 2px; font-weight: 500;
    letter-spacing: 0.05em;
  }
  .proto-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
  .proto-card-sm {
    background: var(--off-white); border: 1px solid var(--light-gray);
    border-radius: 3px; padding: 16px;
  }
  .proto-card-sm-label { font-size: 10px; color: var(--mid-gray); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 8px; }
  .proto-card-sm-val { font-family: var(--mono); font-size: 18px; color: var(--muted-blue); font-weight: 500; }
  .proto-card-sm-sub { font-size: 11px; color: var(--mid-gray); margin-top: 3px; }
  .proto-chart { height: 80px; position: relative; margin-bottom: 16px; }
  .proto-chart-bg {
    position: absolute; inset: 0;
    background: var(--off-white); border: 1px solid var(--light-gray);
    border-radius: 3px; overflow: hidden;
  }
  .proto-info { }
  .proto-info h3 {
    font-size: 17px; font-weight: 600; color: var(--near-black);
    margin-bottom: 12px;
  }
  .proto-info p {
    font-size: 14px; color: #6B6B68; line-height: 1.7; margin-bottom: 20px;
  }
  .proto-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 24px; }
  .proto-tag {
    font-size: 11px; color: #6B6B68; background: var(--white);
    border: 1px solid var(--light-gray); padding: 4px 10px; border-radius: 2px;
  }

  /* ─── ABOUT (lab-first) ─── */
  .about {}
  .about-inner {
    display: grid; grid-template-columns: 3fr 4fr; gap: 80px;
    align-items: start;
  }
  .about-left {}
  .about-lab-mark {
    width: 88px; height: 88px;
    background: var(--navy); border-radius: 4px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 24px;
  }
  .lab-mark-inner { text-align: center; }
  .lab-mark-cw {
    display: block;
    font-family: var(--serif); font-size: 26px; color: #7BA3CC;
    font-weight: 400; line-height: 1; letter-spacing: -0.02em;
  }
  .lab-mark-label {
    display: block;
    font-family: var(--mono); font-size: 8px; color: #4A6070;
    letter-spacing: 0.14em; margin-top: 3px;
  }
  .about-name {
    font-family: var(--serif); font-size: 24px; color: var(--near-black);
    font-weight: 400; margin-bottom: 8px;
  }
  .about-title { font-size: 13px; color: var(--mid-gray); line-height: 1.5; }
  .about-tags {
    display: flex; flex-wrap: wrap; gap: 6px; margin-top: 28px;
  }
  .about-tag {
    font-size: 11px; padding: 5px 12px;
    border: 1px solid var(--light-gray); border-radius: 2px;
    color: #6B6B68; letter-spacing: 0.03em;
  }
  .about-right {}
  .about-body {
    font-size: 16px; color: #5A5A58; line-height: 1.8; margin-bottom: 36px;
    font-weight: 300;
  }
  .about-body p + p { margin-top: 20px; }

  /* Founder card */
  .about-founder { margin-bottom: 36px; }
  .founder-divider {
    display: flex; align-items: center; gap: 16px; margin-bottom: 20px;
  }
  .founder-divider::before, .founder-divider::after {
    content: ''; flex: 1; height: 1px; background: var(--light-gray);
  }
  .founder-divider-label {
    font-size: 11px; font-weight: 500; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--mid-gray); white-space: nowrap;
  }
  .founder-card {
    display: flex; gap: 20px; align-items: flex-start;
    padding: 24px 28px; background: var(--off-white);
    border: 1px solid var(--light-gray); border-radius: 2px;
  }
  .founder-avatar {
    width: 52px; height: 52px; flex-shrink: 0;
    background: var(--light-blue); border: 1px solid #C8D8EA;
    border-radius: 2px; display: flex; align-items: center; justify-content: center;
  }
  .founder-initials {
    font-family: var(--serif); font-size: 18px; color: var(--muted-blue);
    font-weight: 400;
  }
  .founder-info {}
  .founder-name {
    font-size: 15px; font-weight: 600; color: var(--near-black); margin-bottom: 3px;
  }
  .founder-role {
    font-size: 12.5px; color: var(--mid-gray); margin-bottom: 10px;
    letter-spacing: 0.01em;
  }
  .founder-bio {
    font-size: 13.5px; color: #6B6B68; line-height: 1.65;
  }

  .about-affiliations {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2px;
    background: var(--light-gray); border: 1px solid var(--light-gray);
  }
  .affil-item {
    padding: 16px 20px; background: var(--white);
  }
  .affil-label { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mid-gray); margin-bottom: 4px; }
  .affil-name { font-size: 13.5px; font-weight: 500; color: var(--charcoal); }

  /* ─── FINAL CTA ─── */
  .final-cta {
    background: var(--navy);
    text-align: center; padding: 120px 48px;
  }
  .final-cta .section-label { justify-content: center; }
  .final-cta .section-label::before { display: none; }
  .final-cta .section-title { color: var(--white); margin: 0 auto 20px; max-width: 640px; }
