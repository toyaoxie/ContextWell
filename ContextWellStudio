<script>
  // Smooth reveal on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
      }
    });
  }, { threshold: 0.08 });

  document.querySelectorAll('.challenge-card, .service-card, .approach-pillar, .why-item, .affil-item, .whom-card, .sp-card, .process-step').forEach(el => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(20px)';
    el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
    observer.observe(el);
  });

  document.querySelectorAll('.challenge-card').forEach((el, i) => {
    el.style.transitionDelay = `${i * 0.08}s`;
  });
  document.querySelectorAll('.approach-pillar').forEach((el, i) => {
    el.style.transitionDelay = `${i * 0.08}s`;
  });
  document.querySelectorAll('.service-card').forEach((el, i) => {
    el.style.transitionDelay = `${i * 0.1}s`;
  });
  document.querySelectorAll('.whom-card').forEach((el, i) => {
    el.style.transitionDelay = `${i * 0.07}s`;
  });
  document.querySelectorAll('.sp-card').forEach((el, i) => {
    el.style.transitionDelay = `${i * 0.07}s`;
  });
  document.querySelectorAll('.process-step').forEach((el, i) => {
    el.style.transitionDelay = `${i * 0.1}s`;
  });
</script>

